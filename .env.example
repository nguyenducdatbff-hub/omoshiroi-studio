# OMOSHIROI STUDIO - CẤU HÌNH API KEY DÙNG CHUNG
# Nếu bạn muốn em của bạn mở máy lên là có sẵn AI (không cần nhập lại key trên web),
# hãy đổi tên file này thành ".env" và dán Gemini API Key của bạn vào sau dấu "=" bên dưới:

GEMINI_API_KEY=your_gemini_api_key_here

# TypeSafe/Jev — server-side only. Never expose this value in browser code.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_TIMEOUT_SECONDS=15
